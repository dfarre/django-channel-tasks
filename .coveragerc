[run]
branch = true
parallel = true

[report]
# Coverage of the ASGI unit is not measured by pytest-cov, so the corresponding modules are omitted
omit =
    asgi_url_conf.py
    asgi.py
    routing.py
    consumers.py
    authentication.py
    scheduler.py
    tasks.py
    task_inspector.py
    entrypoint.py
exclude_lines =
    raise NotImplementedError
    raise AssertionError
    NO COVER
fail_under = 100
